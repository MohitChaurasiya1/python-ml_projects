*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.model
*.ckpt
*.pt
*.pth
*.onnx
*.tflite
*.pb

# ---------- Large Files ----------
*.csv
*.tsv
*.parquet
*.feather
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.rar

# ---------- Logs ----------
*.log
logs/

